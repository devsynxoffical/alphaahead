# Alpha Ahead – static prerendered React site (LiteSpeed/Apache)
# Every route is prerendered at build time to /<route>.html (see scripts/prerender.js).

DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never re-apply rules to internal redirects (error documents, rewritten .html files)
  RewriteCond %{ENV:REDIRECT_STATUS} .
  RewriteRule ^ - [L]

  # Removed spam pages and old WordPress demo content -> 410 Gone (faster de-indexing)
  RewriteRule ^items/ - [G,L]
  RewriteRule ^(hello-world|sample-page)/?$ - [G,L]
  RewriteRule ^[0-9]{6,}/?$ - [G,L]
  RewriteRule ^(wp-admin|wp-content|wp-includes|wp-login\.php|xmlrpc\.php) - [G,L]

  # Stored website leads are private
  RewriteRule ^leads(/|$) - [F,L]

  # 1. Force HTTPS and the non-www host (single canonical origin)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://alphaaheadllc.com/$1 [R=301,L,NE]

  # 2. Legacy / duplicate URLs
  RewriteRule ^home/?$ / [R=301,L]
  # Old site URLs that still had Google impressions -> current equivalents
  RewriteRule ^contactUs/?$ /contact [NC,R=301,L]
  RewriteRule ^(product|project)/?$ /projects [NC,R=301,L]
  RewriteRule ^agencies/?$ /services [NC,R=301,L]
  RewriteRule ^faq/?$ / [NC,R=301,L]
  RewriteRule ^about-us/?$ /about [NC,R=301,L]
  # US real estate pages moved to our real estate division, Zingo Assist (Nov 2026 site split)
  RewriteRule ^(real-estate-virtual-assistant|transaction-coordinator|real-estate-isa|cold-calling-for-real-estate-investors|virtual-assistant-tampa-st-petersburg)(\.html)?/?$ https://zingoassist.us/ [NC,R=301,L]
  RewriteRule ^blog/(transaction-coordinator-cost|in-house-vs-outsourced-transaction-coordinator|real-estate-cold-calling-cost|is-real-estate-cold-calling-legal)(\.html)?/?$ https://zingoassist.us/ [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]
  # /seo.html -> /seo (only for direct client requests, not internal rewrites)
  RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?] [NC]
  RewriteCond %1 !^(404|index)$
  RewriteRule ^ /%1 [R=301,L]

  # 3. Remove trailing slashes (except root and real directories that hold an index.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # 4. Serve prerendered pages: /seo -> /seo.html, /blog/post -> /blog/post.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ /$1.html [L]

  # 5. Anything else that is not a real file -> real 404 (ErrorDocument above)
</IfModule>

# HTML must always revalidate so new deploys show up immediately
<FilesMatch "\.html$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>

# Hide FTP deploy state file
<Files ".ftp-deploy-sync-state.json">
    Require all denied
</Files>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# Browser caching (hashed JS/CSS can be cached long; HTML always revalidates)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always append X-Frame-Options SAMEORIGIN
</IfModule>
